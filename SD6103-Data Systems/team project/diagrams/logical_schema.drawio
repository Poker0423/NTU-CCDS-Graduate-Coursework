;strokeColor=#334155;strokeWidth=1.6;jumpStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c108"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l174" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=13;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e173"><mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="l175" value="N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=13;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e173"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c176" value="Keys and constraints&lt;br&gt;&lt;br&gt;&#8226; PROXIMITY PRIMARY KEY (block_id, hawker_id) &#8212; one distance per block/hawker pair.&lt;br&gt;&#8226; PROXIMITY is the association (weak) entity: no key of its own, identified by its two parents.&lt;br&gt;&#8226; distance_m, distance_min_m and distance_max_m are all in metres. Bands are [min, max).&lt;br&gt;&#8226; level_id on PROXIMITY is derived from distance_m. Stored for query speed, not source data.&lt;br&gt;&#8226; postal is VARCHAR, not INT: Singapore postal codes can begin with 0.&lt;br&gt;&#8226; 1 / N mark the one and many ends of each foreign key." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFE;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacing=14;fontSize=13;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="80" y="900" width="920" height="200" as="geometry"/></mxCell><mxCell id="c177" value="Legend&lt;br&gt;&lt;br&gt;Blue row = primary key column&lt;br&gt;Amber row = foreign key column&lt;br&gt;White row = ordinary column" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFE;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacing=14;fontSize=13;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="1640" y="700" width="400" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>